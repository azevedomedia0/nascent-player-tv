# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST / PORT: the server binds localhost (127.0.0.1) by default.
# Only set HOST=0.0.0.0 behind a reverse proxy that adds authentication —
# this server has no built-in login. See SECURITY.md.
HOST="127.0.0.1"
PORT="3000"

# NASCENT_API_TOKEN: optional shared token for mutating API calls and
# the sensitive GET endpoints (/api/stremio/proxy, /api/stream/benchmark).
# When set, clients must send `Authorization: Bearer <token>` or
# `x-api-token: <token>`. Leave unset for local-only use.
# NASCENT_API_TOKEN="a-long-random-token"

# STREMIO_PROXY_ALLOWLIST: extra hostnames (comma separated) the
# /api/stremio/proxy endpoint may fetch, in addition to the bundled
# addon hosts (Cinemeta, Torrentio, OpenSubtitles, AnimeKitsu,
# Podcasts, Cyberflix). Never add a wildcard or an internal host.
# STREMIO_PROXY_ALLOWLIST="example-addon.strem.fun"
