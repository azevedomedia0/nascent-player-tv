# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST / PORT: the server binds localhost (127.0.0.1) by default.
# For LAN access set HOST=0.0.0.0 and enable the built-in gateway
# (NASCENT_GATEWAY_PASSWORD) or put nginx/Caddy in front. See SECURITY.md.
HOST="127.0.0.1"
PORT="3000"

# Built-in reverse-proxy gateway (HTTP Basic Auth for the whole app).
# When NASCENT_GATEWAY_PASSWORD is set, every request requires login.
# NASCENT_GATEWAY_USER="nascent"
# NASCENT_GATEWAY_PASSWORD="choose-a-strong-password"

# NASCENT_API_TOKEN: for mutating /api calls and sensitive GETs when
# the gateway is off. Clients send Authorization: Bearer <token> or
# x-api-token: <token>. Prefer NASCENT_GATEWAY_PASSWORD for remote
# browser access. Do NOT set VITE_NASCENT_API_TOKEN — Vite would bake
# it into the bundle. Paste the token once per browser session in
# Settings → Server & LAN → API Token (sessionStorage for that tab).
# NASCENT_API_TOKEN="a-long-random-token"

# STREMIO_PROXY_ALLOWLIST: extra hostnames (comma separated) the
# /api/stremio/proxy endpoint may fetch, in addition to the bundled
# addon hosts (Cinemeta, Torrentio, OpenSubtitles, AnimeKitsu,
# Podcasts, Cyberflix). Never add a wildcard or an internal host.
# STREMIO_PROXY_ALLOWLIST="example-addon.strem.fun"

# PROXY_ALLOWLIST: extra hostnames for the general reverse proxy
# (/api/proxy) beyond Stremio hosts and the built-in media CDN list.
# PROXY_ALLOWLIST="cdn.example.com,media.example.net"
